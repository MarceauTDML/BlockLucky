{
  "expo": {
    "name": "BlockLucky EtherBay",
    "slug": "blocklucky-etherbay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.etherbay.blocklucky",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFDA38"
      },
      "package": "fr.etherbay.blocklucky",
      "allowBackup": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "BlockLucky accède à vos photos pour envoyer le recto et le verso de votre pièce d'identité à la Mairie.",
          "cameraPermission": "BlockLucky utilise l'appareil photo pour photographier votre pièce d'identité afin de vérifier votre âge."
        }
      ],
      "expo-audio"
    ],
    "scheme": ["blocklucky", "fr.etherbay.blocklucky"],
    "extra": {
      "eas": {
        "projectId": "ded4728f-4e10-4d22-bd34-838d51898f82"
      }
    },
    "owner": "marceautdml",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ded4728f-4e10-4d22-bd34-838d51898f82"
    }
  }
}
