{
  "name": "blocklucky-smart-contract",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Smart contract de la Grande Loterie citoyenne BlockLucky de la Ville d'EtherBay",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "typecheck": "hardhat build && tsc --noEmit",
    "lint": "solhint --max-warnings 0 \"contracts/*.sol\"",
    "slither": "sh scripts/slither.sh",
    "test": "hardhat test",
    "test:coverage": "hardhat test --coverage",
    "coverage:check": "node scripts/check-coverage.mjs",
    "test:gas": "hardhat test mocha --gas-stats",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "vrf:sepolia": "hardhat run scripts/setup-vrf-sepolia.ts --network sepolia",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.ts --network sepolia",
    "automation:sepolia": "hardhat run scripts/register-automation-sepolia.ts --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify-sepolia.ts --network sepolia",
    "export:abi": "hardhat build && node scripts/export-abi.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "forge-std": "https://github.com/foundry-rs/forge-std/archive/refs/tags/v1.17.0.tar.gz",
    "hardhat": "^3.21.2",
    "mocha": "^12.0.3",
    "solhint": "^6.2.5",
    "typescript": "~7.0.2"
  }
}
