generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(uuid())
  walletAddress      String             @unique
  email              String?            @unique
  role               Role               @default(USER)
  isTwoFactorEnabled Boolean            @default(false)
  twoFactorMethod    TwoFactorMethod?
  twoFactorSecret    String?
  isEmailVerified    Boolean            @default(false)
  pointsBalance      Int                @default(0)
  referralCode       String             @unique @default(uuid())
  referredById       String?
  referredBy         User?              @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]             @relation("Referrals")
  tickets            Ticket[]
  pointLedger        PointTransaction[]
  claimedRewards     ClaimedReward[]
  tokens             Token[]
  analytics          Analytics[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum TwoFactorMethod {
  APP
  EMAIL
}

model Token {
  id        String    @id @default(uuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

enum TokenType {
  EMAIL_VERIFICATION
  ACCOUNT_DELETION
  PASSWORD_RESET
}

model LotteryRound {
  id                 String    @id @default(uuid())
  contractRoundId    Int       @unique
  status             Status    @default(OPEN)
  prizePool          Float     @default(0.0)
  winnerWallet       String?
  chainlinkRequestId String?
  startedAt          DateTime  @default(now())
  drawnAt            DateTime?
  tickets            Ticket[]
}

enum Status {
  OPEN
  LOCKED
  COMPLETED
  CANCELLED
}

model Ticket {
  id              String       @id @default(uuid())
  transactionHash String       @unique
  blockNumber     Int
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  lotteryId       String
  lottery         LotteryRound @relation(fields: [lotteryId], references: [id])
  purchasedAt     DateTime     @default(now())
}

model PointTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int
  actionType  String
  description String?
  createdAt   DateTime @default(now())
}

model Partner {
  id        String          @id @default(uuid())
  name      String
  logoUrl   String
  isActive  Boolean         @default(true)
  rewards   RewardCatalog[]
  createdAt DateTime        @default(now())
}

model RewardCatalog {
  id             String          @id @default(uuid())
  partnerId      String
  partner        Partner         @relation(fields: [partnerId], references: [id])
  title          String
  costInPoints   Int
  totalStock     Int
  remainingStock Int
  claimedRewards ClaimedReward[]
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
}

model ClaimedReward {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  rewardId      String
  rewardCatalog RewardCatalog @relation(fields: [rewardId], references: [id])
  uniqueCode    String        @unique
  isUsed        Boolean       @default(false)
  claimedAt     DateTime      @default(now())
}

model Analytics {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  eventType String
  utmSource String?
  metadata  Json?
  timestamp DateTime @default(now())
}
