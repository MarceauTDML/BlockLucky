generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(uuid(7))
  walletAddress         String                @unique
  walletEncryptedKey    String?
  welcomeGrantTxHash    String?
  email                 String?               @unique
  passwordHash          String?
  firstName             String?
  lastName              String?
  role                  Role                  @default(USER)
  isTwoFactorEnabled    Boolean               @default(false)
  twoFactorMethod       TwoFactorMethod?
  twoFactorSecret       String?
  twoFactorBackupCodes  String[]              @default([])
  isEmailVerified       Boolean               @default(false)
  ageVerificationStatus AgeVerificationStatus @default(NONE)
  ageVerifiedAt         DateTime?             @db.Timestamptz(3)
  ageVerificationNote   String?
  pointsBalance         Int                   @default(0)
  referralCode          String                @unique @default(uuid())
  referredById          String?
  referredBy            User?                 @relation("Referrals", fields: [referredById], references: [id])
  referrals             User[]                @relation("Referrals")
  tickets               Ticket[]
  pointLedger           PointTransaction[]
  claimedRewards        ClaimedReward[]
  tokens                Token[]
  analytics             Analytics[]
  ownedPartners         Partner[]             @relation("PartnerOwner")
  identityDocument      IdentityDocument?     @relation("IdentityOwner")
  reviewedIdentities    IdentityDocument[]    @relation("IdentityReviewer")
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?             @db.Timestamptz(3)

  @@index([referredById])
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum TwoFactorMethod {
  APP
  EMAIL
}

enum AgeVerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

model IdentityDocument {
  id             String                @id @default(uuid(7))
  userId         String                @unique
  user           User                  @relation("IdentityOwner", fields: [userId], references: [id], onDelete: Cascade)
  status         AgeVerificationStatus @default(PENDING)
  frontEncrypted Bytes?
  backEncrypted  Bytes?
  mimeType       String
  submittedAt    DateTime              @default(now()) @db.Timestamptz(3)
  reviewedAt     DateTime?             @db.Timestamptz(3)
  reviewerId     String?
  reviewer       User?                 @relation("IdentityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([reviewerId])
}

model Token {
  id        String    @id @default(uuid(7))
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFICATION
  ACCOUNT_DELETION
  PASSWORD_RESET
}

model LotteryRound {
  id                 String    @id @default(uuid(7))
  contractRoundId    Int       @unique
  status             Status    @default(OPEN)
  prizePool          Float     @default(0.0)
  winnerWallet       String?
  chainlinkRequestId String?
  ticketPriceWei     String?
  endsAt             DateTime? @db.Timestamptz(3)
  drawRequestedAt    DateTime? @db.Timestamptz(3)
  winningTicket      Int?
  prizeWei           String?
  prizeClaimedAt     DateTime? @db.Timestamptz(3)
  startedAt          DateTime  @default(now()) @db.Timestamptz(3)
  drawnAt            DateTime? @db.Timestamptz(3)
  tickets            Ticket[]

  @@index([status])
}

enum Status {
  OPEN
  LOCKED
  COMPLETED
  CANCELLED
}

model Ticket {
  id              String       @id @default(uuid(7))
  transactionHash String
  blockNumber     Int
  ticketIndex     Int?
  payerWallet     String?
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  lotteryId       String
  lottery         LotteryRound @relation(fields: [lotteryId], references: [id])
  purchasedAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([lotteryId, ticketIndex])
  @@index([userId, purchasedAt])
  @@index([lotteryId])
  @@index([transactionHash])
}

model ChainCursor {
  id        String   @id
  lastBlock Int
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model PointTransaction {
  id          String   @id @default(uuid(7))
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int
  actionType  String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model Partner {
  id        String          @id @default(uuid(7))
  name      String
  logoUrl   String
  isActive  Boolean         @default(true)
  ownerId   String?
  owner     User?           @relation("PartnerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  rewards   RewardCatalog[]
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  @@index([ownerId])
}

model RewardCatalog {
  id             String          @id @default(uuid(7))
  partnerId      String
  partner        Partner         @relation(fields: [partnerId], references: [id])
  title          String
  costInPoints   Int
  totalStock     Int
  remainingStock Int
  claimedRewards ClaimedReward[]
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([partnerId])
}

model ClaimedReward {
  id            String        @id @default(uuid(7))
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  rewardId      String
  rewardCatalog RewardCatalog @relation(fields: [rewardId], references: [id])
  uniqueCode    String        @unique
  isUsed        Boolean       @default(false)
  claimedAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, claimedAt])
  @@index([rewardId])
}

model Analytics {
  id        String   @id @default(uuid(7))
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  eventType String
  utmSource String?
  metadata  Json?
  timestamp DateTime @default(now()) @db.Timestamptz(3)

  @@index([eventType, timestamp])
  @@index([userId])
}
