generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String             @id @default(uuid(7))
  walletAddress        String             @unique
  email                String?            @unique
  role                 Role               @default(USER)
  isTwoFactorEnabled   Boolean            @default(false)
  twoFactorMethod      TwoFactorMethod?
  twoFactorSecret      String?
  twoFactorBackupCodes String[]           @default([])
  isEmailVerified      Boolean            @default(false)
  pointsBalance        Int                @default(0)
  referralCode         String             @unique @default(uuid())
  referredById         String?
  referredBy           User?              @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]             @relation("Referrals")
  tickets              Ticket[]
  pointLedger          PointTransaction[]
  claimedRewards       ClaimedReward[]
  tokens               Token[]
  analytics            Analytics[]
  ownedPartners        Partner[]          @relation("PartnerOwner")
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?          @db.Timestamptz(3)

  @@index([referredById])
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum TwoFactorMethod {
  APP
  EMAIL
}

model Token {
  id        String    @id @default(uuid(7))
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFICATION
  ACCOUNT_DELETION
  PASSWORD_RESET
}

model LotteryRound {
  id                 String    @id @default(uuid(7))
  contractRoundId    Int       @unique
  status             Status    @default(OPEN)
  prizePool          Float     @default(0.0)
  winnerWallet       String?
  chainlinkRequestId String?
  startedAt          DateTime  @default(now()) @db.Timestamptz(3)
  drawnAt            DateTime? @db.Timestamptz(3)
  tickets            Ticket[]

  @@index([status])
}

enum Status {
  OPEN
  LOCKED
  COMPLETED
  CANCELLED
}

model Ticket {
  id              String       @id @default(uuid(7))
  transactionHash String       @unique
  blockNumber     Int
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  lotteryId       String
  lottery         LotteryRound @relation(fields: [lotteryId], references: [id])
  purchasedAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, purchasedAt])
  @@index([lotteryId])
}

model PointTransaction {
  id          String   @id @default(uuid(7))
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int
  actionType  String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model Partner {
  id        String          @id @default(uuid(7))
  name      String
  logoUrl   String
  isActive  Boolean         @default(true)
  ownerId   String?
  owner     User?           @relation("PartnerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  rewards   RewardCatalog[]
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  @@index([ownerId])
}

model RewardCatalog {
  id             String          @id @default(uuid(7))
  partnerId      String
  partner        Partner         @relation(fields: [partnerId], references: [id])
  title          String
  costInPoints   Int
  totalStock     Int
  remainingStock Int
  claimedRewards ClaimedReward[]
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@index([partnerId])
}

model ClaimedReward {
  id            String        @id @default(uuid(7))
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  rewardId      String
  rewardCatalog RewardCatalog @relation(fields: [rewardId], references: [id])
  uniqueCode    String        @unique
  isUsed        Boolean       @default(false)
  claimedAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, claimedAt])
  @@index([rewardId])
}

model Analytics {
  id        String   @id @default(uuid(7))
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  eventType String
  utmSource String?
  metadata  Json?
  timestamp DateTime @default(now()) @db.Timestamptz(3)

  @@index([eventType, timestamp])
  @@index([userId])
}
